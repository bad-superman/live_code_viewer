{
  "name": "live-code-viewer",
  "displayName": "Live Code Viewer",
  "description": "局域网实时协作编程 - 基础维护版，保证现有功能稳定性，为终端共享功能做准备",
  "version": "0.1.6",
  "publisher": "RoyKou",
  "repository": {
    "type": "git",
    "url": "https://github.com/bad-superman/live_code_viewer.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "live",
    "coding",
    "viewer",
    "LAN",
    "pair programming"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "contributes": {
    "commands": [
      {
        "command": "live-code-viewer.startHosting",
        "title": "Live Code: Start Hosting"
      },
      {
        "command": "live-code-viewer.stopHosting",
        "title": "Live Code: Stop Hosting"
      },
      {
        "command": "live-code-viewer.copyAddress",
        "title": "Live Code: Copy Broadcast Address"
      },
      {
        "command": "live-code-viewer.connect",
        "title": "Live Code: Connect to Host"
      },
      {
        "command": "live-code-viewer.disconnect",
        "title": "Live Code: Disconnect"
      },
      {
        "command": "live-code-viewer.createRoom",
        "title": "Live Code: Create Room"
      },
      {
        "command": "live-code-viewer.listRooms",
        "title": "Live Code: List Rooms"
      },
      {
        "command": "live-code-viewer.showRoomPanel",
        "title": "Live Code: Show Room Panel"
      }
    ],
    "configuration": {
      "title": "Live Code Viewer",
      "properties": {
        "liveCodeViewer.port": {
          "type": "number",
          "default": 3456,
          "description": "WebSocket 服务端口号"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "liveCodeViewer",
          "name": "直播项目"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify --sourcemap",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.27.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  }
}
